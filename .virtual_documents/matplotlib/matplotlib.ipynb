#oscar movies 

movie = [
    "the dark knight",
    "dhurandhar",
    "uri",
    "kashmir files",
    "jai hind"
]

year = [2010,2012,2015,2020,2026,2025]
oscar_revenue = [2000,3000,1000,800,4000,1500]
non_oscar = [1000,1200,1750,3400,2000,2200]

plt.plot(year,oscar_revenue,color = "green",linewidth = 2, marker = ">", label = "oscar movie")
plt.plot(year,non_oscar, linestyle = "-.",label = "non oscar")
plt.title("Oscar movies data ")
plt.xlabel("Y ear of Movie")
plt.ylabel("Revenue of Movie ")
plt.legend()





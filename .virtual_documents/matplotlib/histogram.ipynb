import matplotlib.pyplot as plt 

marks = [
    45, 50, 55, 60, 62, 65, 67, 70, 72, 75,
    78, 80, 82, 85, 88, 90, 92, 95, 97, 100,
    55, 60, 65, 70, 75, 80, 85, 90
]

plt.hist(marks, color = "green", edgecolor = "black", bins = 10)
plt.title("Marks range")


legit_transactions = [
    120, 150, 180, 200, 220, 250, 270, 300, 320, 350,
    400, 450, 500, 550, 600, 650, 700, 750, 800, 850
]

fraud_transactions = [
    50, 75, 90, 100, 120, 140, 160, 180, 200, 220,
    250, 280, 300, 350, 400, 450, 500, 600, 700, 900
]


plt.hist(fraud_transactions, color = "red", edgecolor = "black", alpha = 0.5, label = "fruad")
plt.hist(legit_transactions, color = "green", edgecolor = "black", alpha = 0.5 , label = "legit")
plt.xlabel("Amout (in $)")
plt.ylabel("No. of transctions ")
plt.legend()

